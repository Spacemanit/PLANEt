{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "excludeFiles": "{public/**,dist/**,.cache/**,credentials.json,*.glb}"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*).glb",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
